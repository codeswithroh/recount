# Required
OTARI_API_KEY=

# Optional: public URL of this app's MCP endpoint, e.g. https://your-app.example/api/mcp
OTARI_MCP_URL=
# Set to 1 once web access is on for the workspace in the Otari dashboard
OTARI_WEB_TOOLS=0
# Model or routing policy per role
RECOUNT_MODEL_EXTRACTOR=deepseek/deepseek-v4-flash
RECOUNT_MODEL_ANALYST=deepseek/deepseek-v4-pro
RECOUNT_MODEL_SKEPTIC=openai/gpt-oss-120b
# Hard cap per recount, in USD
RECOUNT_BUDGET_USD=0.25
